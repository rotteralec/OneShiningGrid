# One Shining Grid — .gitignore
# Deploy model = Path A (generate-ahead static): the daily grids are generated
# LOCALLY from the stats CSVs and committed under public/. The big stat INPUTS
# therefore never need to live in the repo or in CI.

# --- dependencies / build output ---
node_modules/
dist/

# --- python ---
__pycache__/
*.pyc

# --- OS / editor / env ---
.DS_Store
.env
.env.local
.env.*.local

# --- data INPUTS: ignore ALL .csv (re-sourceable) + the raw data folders.
#     The hand-curated maps the build needs are whitelisted at the bottom. ---
*.csv
RawCBBTeamData/
cbb_conferences_1999-2026/
nba_draft_2000-2025/
cbb_awards/
cbb_conf_poy/
player_data.json
ncaa_colors.rda

# --- backups / old / Apple Numbers source ---
*.bak
*.numbers
index_standalone_old.html

# --- local-only build state (Path A regenerates the horizon fresh; not an artifact) ---
grid_history.json

# --- generated dev/QA previews (re-create via the build_*.py scripts) ---
pennant_preview.html
school_color_preview.html
conference_color_preview.html
_stat_preview.html
/nba_draft_2000-2026
